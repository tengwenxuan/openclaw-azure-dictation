{
  "name": "@tengwenxuan/openclaw-azure-dictation",
  "version": "0.1.1",
  "description": "Azure Speech streaming dictation for OpenClaw dashboard chat drafts",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tengwenxuan/openclaw-azure-dictation.git"
  },
  "homepage": "https://github.com/tengwenxuan/openclaw-azure-dictation#readme",
  "files": ["dist", "openclaw.plugin.json", "README.md", "LICENSE", "NOTICE"],
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run test/provider.test.ts",
    "test:live": "node scripts/live-smoke.mjs",
    "test:install": "node scripts/install-smoke.mjs",
    "validate": "clawhub package validate .",
    "prepack": "npm run build"
  },
  "dependencies": {
    "microsoft-cognitiveservices-speech-sdk": "1.51.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.8"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "openclaw": "2026.10.1",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "compat": {
      "pluginApi": ">=2026.9.8",
      "minGatewayVersion": "2026.9.8"
    },
    "build": {
      "openclawVersion": "2026.10.1"
    },
    "install": {
      "clawhubSpec": "clawhub:@tengwenxuan/openclaw-azure-dictation",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.9.8"
    }
  }
}
